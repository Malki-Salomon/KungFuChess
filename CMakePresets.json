{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Debug (Ninja, full solution)",
      "description": "Everything including the GUI. Single-config, so `cmake --build build` and `ctest --test-dir build` need no --config flag.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (Ninja, full solution)",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "headless",
      "inherits": "base",
      "displayName": "Debug, no GUI (server + tests only)",
      "description": "Drops OpenCV entirely. This is the shape a server container wants: the test suite still builds and runs in full.",
      "binaryDir": "${sourceDir}/build-headless",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KFC_BUILD_GUI": "OFF",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (multi-config)",
      "description": "Multi-config tree for IDE use. Remember --config/-C on build and test commands.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs"
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "release", "configurePreset": "release" },
    { "name": "headless", "configurePreset": "headless" },
    { "name": "vs2022", "configurePreset": "vs2022", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2022",
      "configurePreset": "vs2022",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
